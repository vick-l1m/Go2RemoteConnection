# NOT actually relied on right now -- verified that buildx does not honour a
# .dockerignore for a named --build-context (docker/robot/Dockerfile's
# `--build-context robot=Go2RemoteConnection`) in the version this project builds
# with: a `COPY --from=robot . dest/` transferred this whole submodule, sessions/
# included, ignoring every rule below. The actual exclusion mechanism is the
# explicit file list in that Dockerfile's COPY instructions -- BuildKit only
# transfers what a COPY instruction names. Kept here as documentation of intent
# (and in case a future buildx version fixes named-context .dockerignore support),
# not as something to depend on.
build/
install/
log/
*/build/
*/install/
*/log/

__pycache__/
*.pyc
*.pyo

.vscode/
.idea/
.DS_Store

# 2.6 GB of recorded rosbags -- never belongs in an image.
sessions/

.git

# Marks this submodule for the OUTER Go2_RL_workflow colcon workspace to skip.
# Inside this image, GO2_WS *is* its own colcon workspace and must not inherit that:
# colcon build run from a directory containing COLCON_IGNORE builds nothing at all.
COLCON_IGNORE
